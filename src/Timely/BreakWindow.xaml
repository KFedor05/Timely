<Window x:Class="Timely.BreakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timely"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="SkipButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource T.ControlText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="26,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="9"
                                Background="{DynamicResource T.ControlBg}"
                                BorderBrush="{DynamicResource T.ControlBorder}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource T.ControlBgHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource T.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{DynamicResource T.Overlay}"
            BorderBrush="{DynamicResource T.Border}"
            BorderThickness="1">
        <Grid Margin="64,48,64,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="KindText"
                       Grid.Row="0"
                       HorizontalAlignment="Center"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource T.Accent}"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CountdownText"
                           HorizontalAlignment="Center"
                           FontSize="132"
                           FontWeight="Light"
                           Foreground="{DynamicResource T.Text}"/>
                <TextBlock x:Name="IdeaText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="720"
                           Margin="0,18,0,0"
                           FontSize="21"
                           Foreground="{DynamicResource T.TextSecondary}"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Border Height="6" CornerRadius="3" Background="{DynamicResource T.Track}" HorizontalAlignment="Stretch">
                    <Border x:Name="ProgressFill"
                            HorizontalAlignment="Left"
                            Width="0"
                            CornerRadius="3"
                            Background="{DynamicResource T.Accent}"/>
                </Border>

                <Button x:Name="SkipButton"
                        Style="{StaticResource SkipButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,0"
                        Click="OnSkipClick"/>

                <TextBlock x:Name="HintText"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource T.TextMuted}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
